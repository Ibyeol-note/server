{
  "openapi": "3.0.0",
  "info": {
    "title": "게시판 및 유저 API",
    "version": "1.0.0",
    "description": "게시판과 유저 관리 서비스 API"
  },
  "servers": [
    {
      "url": "https://api.example.com/v1",
      "description": "기본 서버"
    }
  ],
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "username": {
            "type": "string",
            "example": "user01"
          },
          "email": {
            "type": "string",
            "example": "user01@example.com"
          },
          "status": {
            "type": "string",
            "enum": ["active", "inactive", "suspended"],
            "description": "유저의 현재 상태",
            "example": "active"
          },
          "role": {
            "type": "string",
            "enum": ["admin", "user", "guest"],
            "description": "유저의 역할",
            "example": "user"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "유저 생성 날짜",
            "example": "2024-10-22T08:42:00Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "유저 정보 수정 날짜",
            "example": "2024-10-23T09:30:00Z"
          }
        }
      },
      "CreateUserDto": {
        "type": "object",
        "required": ["username", "email", "password", "role"],
        "properties": {
          "username": {
            "type": "string",
            "example": "user01"
          },
          "email": {
            "type": "string",
            "example": "user01@example.com"
          },
          "password": {
            "type": "string",
            "example": "password123"
          },
          "role": {
            "type": "string",
            "enum": ["admin", "user", "guest"],
            "example": "user"
          }
        }
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "newemail@example.com"
          },
          "password": {
            "type": "string",
            "example": "newpassword123"
          },
          "status": {
            "type": "string",
            "enum": ["active", "inactive", "suspended"],
            "description": "유저 상태 업데이트",
            "example": "active"
          }
        }
      },
      "LoginDto": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": {
            "type": "string",
            "example": "user01"
          },
          "password": {
            "type": "string",
            "example": "password123"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "tokenType": {
            "type": "string",
            "enum": ["Bearer", "JWT"],
            "example": "Bearer"
          }
        }
      },
      "Post": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "첫 번째 게시글"
          },
          "content": {
            "type": "string",
            "example": "게시글 내용입니다."
          },
          "author": {
            "type": "string",
            "example": "작성자"
          },
          "status": {
            "type": "string",
            "enum": ["published", "draft", "archived"],
            "description": "게시글 상태",
            "example": "published"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "게시글 생성 날짜",
            "example": "2024-10-22T08:42:00Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "게시글 수정 날짜",
            "example": "2024-10-23T09:00:00Z"
          }
        }
      },
      "CreatePostDto": {
        "type": "object",
        "required": ["title", "content", "author", "status"],
        "properties": {
          "title": {
            "type": "string",
            "example": "새 게시글 제목"
          },
          "content": {
            "type": "string",
            "example": "게시글 내용"
          },
          "author": {
            "type": "string",
            "example": "작성자"
          },
          "status": {
            "type": "string",
            "enum": ["published", "draft", "archived"],
            "description": "게시글 상태",
            "example": "draft"
          }
        }
      },
      "UpdatePostDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "수정된 게시글 제목"
          },
          "content": {
            "type": "string",
            "example": "수정된 게시글 내용"
          },
          "status": {
            "type": "string",
            "enum": ["published", "draft", "archived"],
            "description": "게시글 상태 업데이트",
            "example": "archived"
          }
        }
      }
    }
  },
  "paths": {
    "/user": {
      "post": {
        "summary": "유저 회원가입",
        "tags": ["Users"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "유저 생성 성공",
            "content": {
              "application/json": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        }
      }
    }
  }
}
