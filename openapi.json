{
  "openapi": "3.0.0",
  "info": {
    "title": "IbyeolNote",
    "version": "1.0.0",
    "description": "API documentation for IbyeolNote"
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "user01@example.com"
          },
          "gender": {
            "type": "string",
            "enum": ["MALE", "FEMALE", "NOT_CHOICE"],
            "example": "MALE"
          },
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "birthday": {
            "type": "string",
            "format": "date",
            "example": "1990-01-01"
          },
          "birthdayType": {
            "type": "string",
            "example": "SOLAR"
          },
          "loginType": {
            "type": "string",
            "enum": ["NAVER", "KAKAO", "GOOGLE", "APPLE"],
            "example": "GOOGLE"
          },
          "registrationAt": {
            "type": "string",
            "format": "date-time",
            "example": "2024-10-22T08:42:00Z"
          },
          "isDeleted": {
            "type": "boolean",
            "example": false
          },
          "deletedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": null
          }
        }
      },
      "CreateUserDto": {
        "type": "object",
        "required": ["email", "gender", "loginType"],
        "properties": {
          "email": {
            "type": "string",
            "example": "user01@example.com"
          },
          "gender": {
            "type": "string",
            "enum": ["MALE", "FEMALE", "NOT_CHOICE"],
            "example": "FEMALE"
          },
          "name": {
            "type": "string",
            "example": "Jane Doe"
          },
          "birthday": {
            "type": "string",
            "format": "date",
            "example": "1990-05-15"
          },
          "birthdayType": {
            "type": "string",
            "example": "LUNAR"
          },
          "loginType": {
            "type": "string",
            "enum": ["NAVER", "KAKAO", "GOOGLE", "APPLE"],
            "example": "APPLE"
          }
        }
      },
      "UserProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "nickname": {
            "type": "string",
            "example": "coolnickname"
          },
          "instagram": {
            "type": "string",
            "format": "url",
            "example": "https://instagram.com/coolnickname"
          },
          "relationshipDecision": {
            "type": "string",
            "enum": ["HOLD_ON", "LET_GO"],
            "example": "LET_GO"
          },
          "isDeleted": {
            "type": "boolean",
            "example": false
          },
          "deletedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": null
          }
        }
      },
      "UserImage": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "imageUrl": {
            "type": "string",
            "format": "url",
            "example": "https://example.com/image.jpg"
          },
          "isDeleted": {
            "type": "boolean",
            "example": false
          },
          "deletedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": null
          }
        }
      },
      "Post": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "d290f1ee-6c54-4b01-90e6-d701748f0851"
          },
          "content": {
            "type": "string",
            "example": "This is a post content"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2024-10-22T08:42:00Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": "2024-10-23T09:00:00Z"
          },
          "isDeleted": {
            "type": "boolean",
            "example": false
          },
          "deletedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": null
          }
        }
      },
      "CreatePostDto": {
        "type": "object",
        "required": ["content"],
        "properties": {
          "content": {
            "type": "string",
            "example": "New post content"
          }
        }
      },
      "PostView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2024-10-22T08:42:00Z"
          },
          "isDeleted": {
            "type": "boolean",
            "example": false
          },
          "deletedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": null
          }
        }
      },
      "RefreshToken": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "deviceInfo": {
            "type": "string",
            "enum": ["WEB", "IOS", "ANDROID"],
            "example": "IOS"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "example": "2024-12-31T23:59:59Z"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2024-10-22T08:42:00Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": "2024-10-23T09:30:00Z"
          }
        }
      }
    }
  },
  "paths": {
    "/user": {
      "post": {
        "summary": "Create a new user",
        "tags": ["Users"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/post": {
      "post": {
        "summary": "Create a new post",
        "tags": ["Posts"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePostDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Post successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post"
                }
              }
            }
          }
        }
      }
    }
  }
}
