// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator markdown {
  provider = "prisma-markdown"
  output   = "../../ERD.md"
  title    = "IbyeolNote"
}

model User {
  id Int @id @default(autoincrement())

  /// @format email
  /// @minLength 5
  /// @maxLength 40
  email          String?     @unique
  /// @minLength 1
  /// @maxLength 10
  gender         String      @db.VarChar(10)
  /// @minLength 2
  /// @maxLength 50
  name           String?     @db.VarChar(50)
  /// @format date
  birthday       String?
  /// @minLength 1
  /// @maxLength 10
  birthdayType   String?
  loginMethod    LoginMethod
  registrationAt DateTime    @default(now())

  // Soft Delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // Relation
  profiles      UserProfile[]
  images        UserImage[]
  refreshTokens RefreshToken[]
  posts         Post[]
  postViews     PostView[]
  postLikes     PostLike[]
}

model UserProfile {
  id Int @id @default(autoincrement())

  /// @minLength 2
  /// @maxLength 20
  nickname             String               @db.VarChar(20)
  /// @format url
  /// @minLength 5
  /// @maxLength 50
  instagram            String?              @db.VarChar(50)
  relationshipDecision RelationshipDecision

  // Soft Delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // Relation
  userId Int
  user   User @relation(fields: [userId], references: [id])
}

model UserImage {
  id Int @id @default(autoincrement())

  /// @format url
  /// @minLength 5
  /// @maxLength 255
  imageUrl String @db.VarChar(255)

  // Soft Delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // Relation
  userId Int
  user   User @relation(fields: [userId], references: [id])
}

model RefreshToken {
  id Int @id @default(autoincrement()) @db.UnsignedInt

  /// @minLength 10
  /// @maxLength 255
  token      String     @unique @db.VarChar(255)
  deviceInfo DeviceInfo
  expiresAt  DateTime
  createdAt  DateTime   @default(now())
  updatedAt  DateTime?

  // Relation
  userId Int
  user   User @relation(fields: [userId], references: [id])
}

model Post {
  id String @id @default(uuid())

  /// @maxLength 500
  content   String?   @db.VarChar(500)
  createdAt DateTime  @default(now())
  updatedAt DateTime?

  // Soft Delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // Relation
  userId Int
  user   User       @relation(fields: [userId], references: [id])
  views  PostView[]
  likes  PostLike[]
}

model PostView {
  id Int @id @default(autoincrement()) @db.UnsignedInt

  createdAt DateTime @default(now())

  // Soft Delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // Relation
  postId String
  userId Int
  post   Post   @relation(fields: [postId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

model PostLike {
  id Int @id @default(autoincrement()) @db.UnsignedInt

  createdAt DateTime @default(now())

  // Soft Delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // Relation
  postId String
  userId Int
  post   Post   @relation(fields: [postId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

enum Gender {
  MALE
  FEMALE
  NOT_CHOICE
}

enum LoginMethod {
  NAVER
  KAKAO
  GOOGLE
  APPLE
}

enum RelationshipDecision {
  HOLD_ON
  LET_GO
}

enum DeviceInfo {
  WEB
  IOS
  ANDROID
}
